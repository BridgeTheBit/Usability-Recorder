{
  "manifest_version": 3,
  "name": "Usability Recorder — Web Tracker",
  "version": "1.1.0",
  "description": "Captures rich browser interaction events for the Usability Testing Recorder desktop app.",
  "permissions": [
    "activeTab",
    "tabs",
    "windows",
    "webNavigation",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Usability Recorder Web Tracker"
  }
}
